.env.*
**/.env
!.env.example
!**/.env.example

# FAISS 인덱스·색인 산출물·업로드 (볼륨 /var/lib/frangizer/...에 둔다)
*.faiss
index.pkl
faiss/
faiss_db/
revisions/
uploads/
**/uploads/
var/

# Python
**/__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node / Vue
node_modules/
dist/

# Java / Gradle
build/
bin/
.gradle/
*.class

# OS·에디터
.DS_Store
.idea/
.vscode/

