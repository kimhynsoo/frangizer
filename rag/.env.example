# Root ../.env is the shared backend/RAG configuration. Never commit real values.
INTERNAL_TOKEN=
JWT_SECRET=
JWT_ISSUER=frangizer
JWT_AUDIENCE=frangizer-api
JWT_ALGORITHM=HS256
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
# Korean BM25 + RRF; listwise reranking uses LLM_MODEL/LLM_API_KEY (one extra call per search).
RERANK_ENABLED=true
# All generated counsel answers are reviewed; adaptive is a deprecated alias.
RAG_REVIEW_MODE=always
RAG_DOMAIN=카페 가맹점 운영·창업
# Optional separate key; empty uses LLM_API_KEY.
EMBEDDING_API_KEY=
# Empty uses the model's default dimension. Changing this requires reindexing.
EMBEDDING_DIMENSIONS=
# Optional compatible embedding endpoint; query and indexing share the same client.
EMBEDDING_BASE_URL=
DOCUMENT_STORE_DIR=/var/lib/frangizer
FAISS_DIR=/var/lib/frangizer/faiss
RAG_STATE_DB=/var/lib/frangizer/rag/query-results.sqlite3
# Optional absolute path to A's structured recipe JSON; no automatic raw/staged ingestion.
RECIPE_STRUCTURED_FILE=
# Optional JSON with manually reviewed table hashes (source SHA + table SHA + reviewer + reviewed_at).
TABLE_REVIEW_FILE=
