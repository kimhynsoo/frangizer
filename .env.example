# 복사해서 .env로 쓴다: cp .env.example .env  (.env는 커밋 금지)

# --- 공통: Java와 FastAPI RAG가 같은 값을 써야 한다 ---
JWT_SECRET=
JWT_ISSUER=frangizer
JWT_AUDIENCE=frangizer-api
INTERNAL_TOKEN=

# --- backend (Java) ---
# 로컬 bootRun용 값. docker compose에서는 DB_URL·RAG_URL을 compose가 서비스 이름으로 덮어쓴다.
DB_URL=jdbc:mariadb://localhost:3306/frangizer
DB_USERNAME=frangizer
DB_PASSWORD=
RAG_URL=http://localhost:8001
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DOCUMENT_STORE_DIR=/var/lib/frangizer
DEMO_PASSWORD=

# --- rag (FastAPI) ---
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
FAISS_DIR=/var/lib/frangizer/faiss

# --- docker compose 전용 ---
DB_NAME=frangizer
WEB_PORT=80
WHISPER_MODEL=small
