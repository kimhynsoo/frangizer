# 복사해서 .env로 쓴다: cp .env.example .env  (.env는 커밋 금지)

# --- 공통: Java와 FastAPI RAG가 같은 값을 써야 한다 ---
JWT_SECRET=
JWT_ISSUER=frangizer
JWT_AUDIENCE=frangizer-api
JWT_ALGORITHM=HS256
INTERNAL_TOKEN=

# --- backend (Java) ---
# 로컬 bootRun용 값. docker compose에서는 DB_URL·RAG_URL을 compose가 서비스 이름으로 덮어쓴다.
DB_URL=jdbc:mariadb://localhost:3306/frangizer
DB_USERNAME=frangizer
DB_PASSWORD=
RAG_URL=http://localhost:8001
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DOCUMENT_STORE_DIR=/var/lib/frangizer
DEMO_PASSWORD=

# --- rag (FastAPI) ---
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
FAISS_DIR=/var/lib/frangizer/faiss

# --- docker compose 전용 ---
DB_NAME=frangizer
WEB_PORT=80
WHISPER_MODEL=small
# 선택: 임베딩 전용 키/호환 엔드포인트. 비우면 LLM_API_KEY와 OpenAI 기본 주소 사용
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=
EMBEDDING_BASE_URL=
# backend/RAG 공통 문서 볼륨 아래에 저장
FAISS_DIR=/var/lib/frangizer/faiss
RAG_STATE_DB=/var/lib/frangizer/rag/query-results.sqlite3
# 구조화 레시피를 사용할 때 컨테이너 안의 JSON 절대 경로 지정(COPY/마운트 필요)
RECIPE_STRUCTURED_FILE=
TABLE_REVIEW_FILE=
