# Copy to .env and fill in. Never commit .env.
# Names follow docs/api/API_명세서.md (11.3). Values stay empty here.

# --- shared (backend, rag, voice use the same values) ---
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
INTERNAL_TOKEN=

# --- db ---
DB_NAME=frangizer
DB_PASSWORD=

# --- rag ---
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
FAISS_DIR=/var/lib/frangizer/faiss
DOCUMENT_STORE_DIR=/var/lib/frangizer/documents

# --- voice (optional) ---
WHISPER_MODEL=small

# --- web ---
WEB_PORT=80
